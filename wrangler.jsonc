{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "friday-night-rewind",
  "main": "./worker/index.js",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  // Silence the build warnings: be explicit rather than relying on defaults.
  "workers_dev": true,
  "preview_urls": false,
  // Preserve secrets and vars already on the Worker. Without this, deploy
  // reconciles bindings against this file and drops anything not declared
  // here -- including secrets set moments earlier by the build step.
  "keep_vars": true,
  "vars": {
    "NOTIFY_TO": "Fridaynightrewind06@gmail.com"
  },
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "friday-night-rewind"
    }
  ],
  "triggers": {
    // Nightly retention sweep: deletes customer footage past its expiry.
    "crons": ["0 7 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "friday-night-rewind",
      // Replaced with the real id by `wrangler d1 create friday-night-rewind`.
      "database_id": "7271755b-06b2-4dd6-90a6-3b38a5a3cd98"
    }
  ]
}
