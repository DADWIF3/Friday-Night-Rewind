{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "friday-night-rewind-preview",
  "main": "./worker/index.js",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NOTIFY_TO": "Fridaynightrewind06@gmail.com"
  },
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "friday-night-rewind"
    }
  ],
  "triggers": {
    // Nightly retention sweep: deletes customer footage past its expiry.
    "crons": ["0 7 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "friday-night-rewind",
      // Replaced with the real id by `wrangler d1 create friday-night-rewind`.
      "database_id": "7271755b-06b2-4dd6-90a6-3b38a5a3cd98"
    }
  ]
}
